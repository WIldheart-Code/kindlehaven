{
  "appId": "com.wildheartgaming.kindlehaven",
  "appName": "Kindlehaven",
  "webDir": "www",
  "backgroundColor": "#d6e9f8",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#d6e9f8"
  },
  "android": {
    "backgroundColor": "#d6e9f8"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#d6e9f8",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
